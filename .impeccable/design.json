      "css": ".ds-data{font:13px/1.7 system-ui,-apple-system,\"Segoe UI\",\"Microsoft YaHei\",sans-serif;margin-top:10px;color:var(--ink,#152a2d)}.ds-data summary{cursor:pointer;padding:10px 0;color:var(--green,#126247);width:fit-content}.ds-data summary:hover{text-decoration:underline;text-underline-offset:4px}.ds-data summary:focus-visible,.ds-table-wrap:focus-visible{outline:3px solid var(--focus,#175d8d);outline-offset:4px}.ds-table-wrap{overflow:auto;max-width:100%}.ds-data table{border-collapse:collapse;width:100%;font-size:12px;font-variant-numeric:tabular-nums;white-space:nowrap;background:var(--surface,#fff)}.ds-data th,.ds-data td{border-bottom:1px solid #dee4df;padding:9px 12px;text-align:right}.ds-data th:first-child,.ds-data td:first-child{text-align:left}.ds-data thead{color:var(--muted,#506264)}.ds-data th{font-weight:600}.ds-data tbody tr:hover{background:#f0f5ef}"
