# Generate schemas with a HOST executable (also when the database targets mobile).
function(fengqudb_generate_models)
  cmake_parse_arguments(FQ "" "SCHEMA;SOURCE;SCHEMA_LOCK;OUTPUT;COMPILER;TARGET" "LANGUAGES" ${ARGN})
  if(NOT FQ_COMPILER AND FengquDB_CODEGEN_EXECUTABLE)
    set(FQ_COMPILER "${FengquDB_CODEGEN_EXECUTABLE}")
  endif()
  if((NOT FQ_SCHEMA AND NOT FQ_SOURCE) OR (FQ_SCHEMA AND FQ_SOURCE) OR NOT FQ_OUTPUT OR NOT FQ_COMPILER OR NOT FQ_TARGET)
    message(FATAL_ERROR "fengqudb_generate_models requires SCHEMA or SOURCE, plus OUTPUT, COMPILER, TARGET")
  endif()
  if(NOT FQ_LANGUAGES)
    set(FQ_LANGUAGES cpp)
  endif()
  list(JOIN FQ_LANGUAGES "," FQ_LANG_LIST)
  get_filename_component(FQ_OUTPUT "${FQ_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
  if(FQ_SOURCE)
    get_filename_component(FQ_SOURCE "${FQ_SOURCE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    set(FQ_GENERATE_ARGS --source "${FQ_SOURCE}" --source-language cpp)
    if(NOT FQ_SCHEMA_LOCK)
      set(FQ_SCHEMA_LOCK "${CMAKE_CURRENT_SOURCE_DIR}/FengquDB.schema.lock.json")
    endif()
    get_filename_component(FQ_SCHEMA_LOCK "${FQ_SCHEMA_LOCK}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    list(APPEND FQ_GENERATE_ARGS --schema-lock "${FQ_SCHEMA_LOCK}")
    set(FQ_DEPENDENCY "${FQ_SOURCE}")
  else()
    get_filename_component(FQ_SCHEMA "${FQ_SCHEMA}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    set(FQ_GENERATE_ARGS --schema "${FQ_SCHEMA}" --lang "${FQ_LANG_LIST}")
    set(FQ_DEPENDENCY "${FQ_SCHEMA}")
  endif()
  # The CLI compares bytes and preserves unchanged mtimes. Running this small
  # target also regenerates a deleted output, without relying on a stale stamp.
  add_custom_target(${FQ_TARGET}
    COMMAND "${FQ_COMPILER}" generate ${FQ_GENERATE_ARGS} --output "${FQ_OUTPUT}"
    DEPENDS "${FQ_DEPENDENCY}" VERBATIM)
  if(TARGET fqdb_codegen)
    add_dependencies(${FQ_TARGET} fqdb_codegen)
  endif()
endfunction()
