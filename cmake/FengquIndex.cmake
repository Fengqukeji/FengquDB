# Optional native retrieval library; the database core and normal SDK stay model-free.
option(FQDB_BUILD_INDEX "Build native lexical, filtered and vector retrieval" OFF)
option(FQDB_BUILD_INDEX_BENCHMARKS "Build focused native index benchmarks" OFF)
if(FQDB_BUILD_INDEX)
  if(FQDB_SHARED)
    add_library(fengqudb_index SHARED src/index/index.cpp)
  else()
    add_library(fengqudb_index STATIC src/index/index.cpp)
    target_compile_definitions(fengqudb_index PUBLIC FQIDX_STATIC)
  endif()
  target_compile_definitions(fengqudb_index PRIVATE FQIDX_BUILD NOMINMAX WIN32_LEAN_AND_MEAN)
  target_compile_features(fengqudb_index PRIVATE cxx_std_20)
  target_include_directories(fengqudb_index PRIVATE src/index)
  target_link_libraries(fengqudb_index PUBLIC fengqudb)
  fqdb_compile_options(fengqudb_index)
  set_target_properties(fengqudb_index PROPERTIES EXPORT_NAME Index VERSION 0.1.0 SOVERSION 1)
  add_library(FengquDB::Index ALIAS fengqudb_index)
  if(CMAKE_SYSTEM_NAME MATCHES "^(Linux|Android)$" AND FQDB_SHARED)
    target_link_options(fengqudb_index PRIVATE "LINKER:--version-script=${CMAKE_CURRENT_SOURCE_DIR}/src/index/exports.map")
    set_property(TARGET fengqudb_index APPEND PROPERTY LINK_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/src/index/exports.map)
  endif()
  install(TARGETS fengqudb_index EXPORT FengquDBTargets RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR} ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
  install(FILES include/fengqudb_index.h include/fengqudb_index.hpp DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
  install(FILES proto/index.proto DESTINATION share/fengqudb/proto)
  install(DIRECTORY examples/index DESTINATION share/fengqudb/examples)
  if(FQDB_BUILD_INDEX_BENCHMARKS)
    add_executable(fqdb_index_lookup_bench tests/index/lookup_bench.cpp)
    target_compile_features(fqdb_index_lookup_bench PRIVATE cxx_std_20)
    target_link_libraries(fqdb_index_lookup_bench PRIVATE FengquDB::Index)
    fqdb_compile_options(fqdb_index_lookup_bench)
  endif()
  if(BUILD_TESTING)
    add_executable(fqdb_index_tests tests/index/native_tests.cpp)
    target_compile_features(fqdb_index_tests PRIVATE cxx_std_20)
    target_link_libraries(fqdb_index_tests PRIVATE FengquDB::Index)
    fqdb_compile_options(fqdb_index_tests)
    add_test(NAME native_index COMMAND fqdb_index_tests)
    set_tests_properties(native_index PROPERTIES TIMEOUT 90)
    add_executable(fqdb_index_cpp_tests tests/index/cpp_tests.cpp)
    target_compile_features(fqdb_index_cpp_tests PRIVATE cxx_std_20)
    target_link_libraries(fqdb_index_cpp_tests PRIVATE FengquDB::Index)
    fqdb_compile_options(fqdb_index_cpp_tests)
    add_test(NAME native_index_cpp COMMAND fqdb_index_cpp_tests)
    set_tests_properties(native_index_cpp PROPERTIES TIMEOUT 60)
    add_executable(fqdb_index_extended_tests tests/index/extended_tests.cpp)
    target_compile_features(fqdb_index_extended_tests PRIVATE cxx_std_20)
    target_link_libraries(fqdb_index_extended_tests PRIVATE FengquDB::Index)
    fqdb_compile_options(fqdb_index_extended_tests)
    add_test(NAME native_index_extended COMMAND fqdb_index_extended_tests)
    set_tests_properties(native_index_extended PROPERTIES TIMEOUT 240)
    find_package(Python3 COMPONENTS Interpreter QUIET)
    if(Python3_Interpreter_FOUND)
      add_test(NAME python_index COMMAND ${Python3_EXECUTABLE} -m unittest discover
        -s tests -p test_fengqudb_index_python.py)
      set_tests_properties(python_index PROPERTIES TIMEOUT 90
        WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
        ENVIRONMENT "FENGQUDB_LIBRARY=$<TARGET_FILE:fengqudb>;FENGQUDB_INDEX_LIBRARY=$<TARGET_FILE:fengqudb_index>")
      add_test(NAME store_bridge COMMAND ${Python3_EXECUTABLE} tests/store_bridge.py
        --library $<TARGET_FILE:fengqudb>)
      set_tests_properties(store_bridge PROPERTIES TIMEOUT 60
        WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})
    endif()
  endif()
endif()
